{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScanBenchRecord",
  "type": "object",
  "required": ["schema_version", "sample_id", "sample_hash", "domain", "device_class", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "sample_id": {"type": "string"},
    "sample_hash": {"type": "string"},
    "domain": {"type": "string"},
    "device_class": {"type": "string"},
    "metrics": {
      "type": "object",
      "properties": {
        "operation": {"type": "string"},
        "iterations": {"type": "integer", "minimum": 1},
        "elapsed_nanoseconds": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "number", "minimum": 0},
        "best_candidate_score": {"type": "number", "minimum": 0, "maximum": 1},
        "fused_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "disagreement_score": {"type": "number", "minimum": 0, "maximum": 1},
        "quad_corner_error": {"type": "number", "minimum": 0},
        "quad_iou": {"type": "number", "minimum": 0, "maximum": 1},
        "edge_support": {"type": "number", "minimum": 0, "maximum": 1},
        "refinement_delta": {"type": "number", "minimum": 0},
        "temporal_stability": {"type": "number", "minimum": 0, "maximum": 1},
        "capture_readiness_score": {"type": "number", "minimum": 0, "maximum": 1},
        "reconstruction_latency": {"type": "number", "minimum": 0},
        "output_width": {"type": "integer", "minimum": 1},
        "output_height": {"type": "integer", "minimum": 1},
        "aspect_error": {"type": "number", "minimum": 0},
        "corner_reprojection_error": {"type": "number", "minimum": 0},
        "coverage_loss": {"type": "number", "minimum": 0, "maximum": 1},
        "warp_stretch_score": {"type": "number", "minimum": 0, "maximum": 1},
        "condition_count": {"type": "integer", "minimum": 0},
        "processor_count": {"type": "integer", "minimum": 0},
        "router_cost_estimate": {"type": "number", "minimum": 0},
        "restoration_delta_contrast": {"type": "number"},
        "binarization_foreground_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
